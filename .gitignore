# Build directories
build/

# ESP-IDF
sdkconfig.old
managed_components/
dependencies.lock

# Generated files
main/web/*.gz

# Per-build fingerprint written by CI (see CMakeLists.txt / build_sha gate)
build_sha.txt

# Dependencies (fetched via fetch_repos.py)
dependencies/

# Python
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
.env
.venv
.hypothesis/
.pytest_cache/
*.egg-info/
env/
venv/

# IDE
.idea/
.vscode/
*.swp
*.swo
*~

# OS
.DS_Store
Thumbs.db

# Logs
*.log

# Test failure screenshots
tests/device/screenshots/
tests/web/screenshots/

# Compiled files
*.o
*.obj
*.elf
*.bin
*.map
*.hex

# TLS certificates (embedded at build time, stored in GitHub secrets for CI)
main/certs/*.pem

# Device wait-latency telemetry (regenerated each run; see tests/api/test_latency_budget.py)
tests/.latency-samples.json
